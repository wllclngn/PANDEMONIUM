gauge statistical mean 10.0000 0 899 pandemonium_scale_burst_p99_us{scheduler="PANDEMONIUM (BPF)",cores="2"}
gauge statistical mean 10.0000 0 2179 pandemonium_scale_longrun_latency_p99_us{scheduler="PANDEMONIUM (BPF)",cores="2"}
