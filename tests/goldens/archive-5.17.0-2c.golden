# montauk behavioral golden -- one frozen fact per line.
# Hand-editable: per-key tolerance is editing one gauge line.
golden_version 2
workload archive-5.17.0-2c
montauk_version 8.7.0
env kernel 7.1.5-arch1-2
env cpu AMD Ryzen 5 3600 6-Core Processor
env cores 12
completeness unknown
gauge statistical mean 10.0000 0 2883 pandemonium_scale_latency_p99_us{scheduler="EEVDF",cores="2"}
gauge statistical mean 10.0000 0 2713 pandemonium_scale_burst_p99_us{scheduler="EEVDF",cores="2"}
gauge statistical mean 10.0000 0 3905 pandemonium_scale_longrun_latency_p99_us{scheduler="EEVDF",cores="2"}
gauge statistical mean 10.0000 0 3020 pandemonium_scale_mixed_latency_p99_us{scheduler="EEVDF",cores="2"}
gauge statistical mean 10.0000 0 0.2543 pandemonium_scale_deadline_miss_ratio{scheduler="EEVDF",cores="2"}
